# Password for the admin panel (required)
ADMIN_PASSWORD=change-me-to-something-long

# Optional: serve the admin panel on its own domain over HTTPS
# (the domain must point to this server). Leave empty to use only
# http://127.0.0.1:8080 via an SSH tunnel.
ADMIN_DOMAIN=

# Optional: e-mail for Let's Encrypt expiry notices
ACME_EMAIL=
